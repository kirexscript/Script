-- FTAP Rocket Control Script v2.0
-- Для Delta Executor (Android/iOS) + Orion Library
-- Авто-камера 3-го лица, управление ракетами пальцем/джойстиком

local Orion = loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/OrionLibrary.lua"))()
local Player = game.Players.LocalPlayer
local Mouse = Player:GetMouse()
local Camera = workspace.CurrentCamera

-- Переменные управления
local controlledRocket = nil
local controlEnabled = false
local camOffset = Vector3.new(0, 5, -15) -- 3-е лицо

-- Функция поиска ракеты (снаряда игрока)
local function findPlayerRocket()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("rocket") or v.Name:lower():find("missile") or v:FindFirstChild("Handle") then
            if v:FindFirstAncestorOfClass("Model") and v:FindFirstAncestorOfClass("Model"):FindFirstChild("Humanoid") == nil then
                -- Проверка владельца через NetworkOwnership (приблизительно)
                local owner = v:GetNetworkOwner()
                if owner == Player then
                    return v
                end
            end
        end
    end
    return nil
end

-- Управление ракетой через сдвиг мыши/пальца
local function controlRocket(rocket, direction)
    if not rocket or not rocket.Parent then return end
    local velocity = rocket.Velocity
    if velocity.Magnitude < 10 then return end
    -- Применяем импульс в сторону направления (перпендикулярно скорости)
    local right = rocket.CFrame.RightVector
    local up = rocket.CFrame.UpVector
    local force = (right * direction.X + up * direction.Y) * 150 -- чувствительность
    rocket:ApplyImpulse(force)
end

-- Создание GUI меню
local Window = Orion:MakeWindow({
    Name = "FTAP Rocket Controller",
    HidePremium = false,
    SaveConfig = true,
    ConfigFolder = "FTAP_Config",
    IntroText = "Rocket Control Active"
})

local MainTab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

-- Переключатель управления
local toggleControl = MainTab:AddToggle({
    Name = "Enable Rocket Control",
    Default = false,
    Callback = function(value)
        controlEnabled = value
        if value then
            controlledRocket = findPlayerRocket()
            if controlledRocket then
                Camera.CameraSubject = controlledRocket
                Camera.CameraType = Enum.CameraType.Scriptable
                -- Установка камеры сзади
                game:GetService("RunService").RenderStepped:Connect(function()
                    if controlledRocket and controlledRocket.Parent then
                        local lookAt = controlledRocket.Position
                        local camPos = lookAt + controlledRocket.CFrame:VectorToWorldSpace(camOffset)
                        Camera.CFrame = CFrame.new(camPos, lookAt)
                    end
                end)
            else
                Orion:MakeNotification({
                    Name = "No Rocket Found",
                    Content = "Fire a rocket first, then enable.",
                    Image = "rbxassetid://4483345998",
                    Time = 2
                })
                toggleControl:Set(false)
            end
        else
            Camera.CameraType = Enum.CameraType.Custom
            controlledRocket = nil
        end
    end
})

-- Ручной поиск ракеты
MainTab:AddButton({
    Name = "Force Find Rocket",
    Callback = function()
        local r = findPlayerRocket()
        if r then
            controlledRocket = r
            Orion:MakeNotification({
                Name = "Rocket Locked",
                Content = "Now controlling: " .. r.Name,
                Image = "rbxassetid://4483345998",
                Time = 2
            })
        else
            Orion:MakeNotification({
                Name = "No Rocket",
                Content = "No active rocket owned by you.",
                Image = "rbxassetid://4483345998",
                Time = 2
            })
        end
    end
})

-- Сенсорный джойстик для планшета (по умолчанию экран делится на 4 зоны)
local joystickActive = false
local joystickStart = nil

MainTab:AddToggle({
    Name = "Touch Joystick (Tablet)",
    Default = false,
    Callback = function(val)
        joystickActive = val
        if val then
            -- Создаём невидимую кнопку на весь экран
            local screenGui = Instance.new("ScreenGui")
            screenGui.Name = "JoystickOverlay"
            screenGui.Parent = Player.PlayerGui
            
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, 0, 1, 0)
            frame.BackgroundTransparency = 1
            frame.Parent = screenGui
            
            frame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    joystickStart = input.Position
                end
            end)
            
            frame.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch and joystickStart and controlEnabled and controlledRocket then
                    local delta = (input.Position - joystickStart) / 100
                    local dir = Vector2.new(math.clamp(delta.X, -1, 1), math.clamp(delta.Y, -1, 1))
                    if dir.Magnitude > 0.1 then
                        controlRocket(controlledRocket, dir)
                    end
                end
            end)
            
            frame.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    joystickStart = nil
                end
            end)
        else
            local gui = Player.PlayerGui:FindFirstChild("JoystickOverlay")
            if gui then gui:Destroy() end
        end
    end
})

-- Клавиатурное управление (для планшетов с клавиатурой)
MainTab:AddParagraph({
    Name = "Keyboard Controls",
    Content = "WASD / Arrow Keys for direction when enabled."
})

game:GetService("UserInputService").InputBegan:Connect(function(input, gp)
    if gp then return end
    if not controlEnabled or not controlledRocket then return end
    local dir = Vector2.new(0,0)
    if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.Up then dir = Vector2.new(0, 1) end
    if input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.Down then dir = Vector2.new(0, -1) end
    if input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.Left then dir = Vector2.new(-1, 0) end
    if input.KeyCode == Enum.KeyCode.D or input.KeyCode == Enum.KeyCode.Right then dir = Vector2.new(1, 0) end
    if dir.Magnitude > 0 then
        controlRocket(controlledRocket, dir)
    end
end)

-- Индикатор статуса
MainTab:AddLabel("Status: Ready - Fire rocket, enable toggle, and steer!")

-- Авто-обновление ракеты при запуске новой
game:GetService("RunService").Heartbeat:Connect(function()
    if controlEnabled and (not controlledRocket or not controlledRocket.Parent) then
        local newRocket = findPlayerRocket()
        if newRocket then
            controlledRocket = newRocket
            Camera.CameraSubject = controlledRocket
        end
    end
end)

Orion:Init()
